# Comma-separated Firebase Auth emails allowed to receive the admin custom claim.
ADMIN_EMAILS=you@example.com

# Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://nextjs-e-website-default-rtdb.europe-west1.firebasedatabase.app

# Service account JSON (raw JSON string) OR base64-encoded JSON.
# Create in Firebase Console → Project settings → Service accounts.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"nextjs-e-website",...}
